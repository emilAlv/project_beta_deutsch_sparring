# Copy this file to .env.local (same folder) and fill it in. .env.local is never committed.

# Test without AI: the tutor answers with built-in demo replies.
MOCK=1
# (demo test words in the chat: langsam, kaputt, rohtext, absturz)

# Class code students must type (case-sensitive). Leave empty to skip the code question.
CLASS_CODE=Eruditus

# Real tutor: put your key from Google AI Studio here and remove MOCK=1 above.
# GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# DAILY_LIMIT=150

# Accounts (log in with username + password) – see docs/security-accounts.md.
# ON only when SESSION_SECRET is set AND a database is connected; otherwise name + class code as before.
# On Vercel the Neon integration sets DATABASE_URL / POSTGRES_URL for you.
# DATABASE_URL=
# SESSION_SECRET=   (a long random text, 40+ characters; never reuse a real password)
# Local test without a database: accounts kept in memory, lost on restart (ignored on Vercel)
# AUTH_MEMORY=1
